{
  "name": "Steam Arabic Official (RTL)",
  "native-name": "ستيم الرسمي بالعربية (RTL)",
  "author": "iTzJok3r",
  "version": "1.0.0",
  "description": "تعريب رسمي متكامل وتخطيط عربي أصيل (RTL) مع أداء فائق وسرعة آنية وأمان تام.",
  "github": {
    "owner": "iTzJok3r",
    "repo_name": "steam-arabic-official"
  },
  "UseDefaultPatches": true,
  "Globals": {
    "accent-color": "#66c0f4",
    "background-color": "#171a21",
    "surface-color": "#1b2838",
    "primary-text-color": "#e8eaed",
    "secondary-text-color": "#8f98a0"
  },
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "libraryroot.custom.css",
      "TargetJs": "theme.js"
    },
    {
      "MatchRegexString": "^Friends$",
      "TargetCss": "friends.custom.css",
      "TargetJs": "theme.js"
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": "friends.custom.css",
      "TargetJs": "theme.js"
    },
    {
      "MatchRegexString": ".ModalDialogPopup",
      "TargetCss": "libraryroot.custom.css",
      "TargetJs": "theme.js"
    },
    {
      "MatchRegexString": ".FullModalOverlay",
      "TargetCss": "libraryroot.custom.css",
      "TargetJs": "theme.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetCss": "webkit.custom.css",
      "TargetJs": "theme.js"
    }
  ]
}
